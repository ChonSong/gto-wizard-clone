#!/bin/bash
# === Structural Enforcement Pre-Commit Hook ===
# Installed by dev-loop structural enforcement system.
# These gates run BEFORE every commit — no LLM involved.
# TRAIL (Patronus 2025): LLM trace review has 11% accuracy ceiling.
# These deterministic checks catch what LLMs cannot see.

set -euo pipefail

PASS=0
FAIL=0
STAGED_FILES=$(git diff --cached --name-only)
STAGED_DIFF=$(git diff --cached)

# ── GATE 1: Must-Change Gate (DELEGATE-52) ─────────────────────
# Reject commits with zero actual changes.
CHANGED_LINES=$(echo "$STAGED_DIFF" | grep -c '^[+-]' || true)
if [ "$CHANGED_LINES" -eq 0 ]; then
    echo "⛔ GATE 1 FAILED: Must-change gate — zero lines changed."
    echo "   This would produce an empty commit."
    echo "   Abort and investigate: did the Player actually produce work?"
    FAIL=$((FAIL + 1))
else
    echo "✅ GATE 1 PASSED: $CHANGED_LINES lines changed."
    PASS=$((PASS + 1))
fi

# ── GATE 2: Security Scan ─────────────────────────────────────
SECRET_PATTERNS='(api_key|API_KEY|secret_key|SECRET_KEY|token|TOKEN|sk-[a-zA-Z0-9]{20,})'
if echo "$STAGED_DIFF" | grep -qiE "$SECRET_PATTERNS" 2>/dev/null; then
    echo "⛔ GATE 2 FAILED: Security scan — possible secret detected in diff."
    echo "   Check: git diff --cached | grep -iE '$SECRET_PATTERNS'"
    FAIL=$((FAIL + 1))
else
    echo "✅ GATE 2 PASSED: No secrets detected."
    PASS=$((PASS + 1))
fi

# ── GATE 3: No Self-Referential Test Tasks in AGENTS.md ───────
# Reject tasks that say "Add E2E test for X" where X is built this commit.
if echo "$STAGED_FILES" | grep -q "AGENTS.md"; then
    if echo "$STAGED_DIFF" | grep -qP 'Add E2E test for'; then
        echo "⛔ GATE 3 FAILED: Self-referential test task detected in AGENTS.md."
        echo "   Pattern: 'Add E2E test for X' where X is being built in same commit."
        echo "   This creates tests that validate implementation, not requirements."
        echo "   Fix: define expected behavior from reference FIRST, then implement."
        FAIL=$((FAIL + 1))
    else
        echo "✅ GATE 3 PASSED: No self-referential test tasks."
        PASS=$((PASS + 1))
    fi
else
    echo "⏭️  GATE 3 SKIPPED: AGENTS.md not in this commit."
fi

# ── GATE 4: File Provenance (DELEGATE-52 distractor pattern) ──
# Warns (but doesn't block) when files_read >> files_changed.
# This is a signal of agent confusion.
FILES_ADDED=$(echo "$STAGED_DIFF" | grep -c '^+++' || true)
FILES_REMOVED=$(echo "$STAGED_DIFF" | grep -c '^---' || true)
FILES_CHANGED=$((FILES_ADDED + FILES_REMOVED))
if [ "$FILES_CHANGED" -eq 0 ]; then
    echo "⚠️  GATE 4 WARNING: Zero files changed — verify this isn't a no-op commit."
elif [ "$FILES_CHANGED" -gt 10 ]; then
    echo "⚠️  GATE 4 WARNING: $FILES_CHANGED files changed — verify scope isn't creeping."
    echo "   If this is intentional, proceed. Otherwise consider splitting into multiple commits."
else
    echo "✅ GATE 4 PASSED: $FILES_CHANGED files changed."
    PASS=$((PASS + 1))
fi

# ── GATE 5: Diff Size ──────────────────────────────────────────
DIFF_LINES=$(echo "$STAGED_DIFF" | wc -l)
if [ "$DIFF_LINES" -gt 500 ]; then
    echo "⚠️  GATE 5 WARNING: $DIFF_LINES lines in diff — verify scope. Consider splitting."
else
    echo "✅ GATE 5 PASSED: $DIFF_LINES lines in diff."
    PASS=$((PASS + 1))
fi

# ── GATE 6: Deployed-Hash Meaningful Changes (7ad9ad9 pattern) ─
# Block commits where .deployed-hash is the ONLY staged file OR
# where co-staged files have no meaningful changes (empty, whitespace-only).
# Commit 7ad9ad9 claimed to fix PostflopTraining but only changed
# .deployed-hash — 0 source changes. This gate prevents that pattern
# and its trivial bypass (staging an empty companion file).
DEPLOYED_HASH_STAGED=0
OTHER_FILES_STAGED=0
MEANINGFUL_CHANGE=0

for f in $STAGED_FILES; do
    if [ "$f" = ".deployed-hash" ]; then
        DEPLOYED_HASH_STAGED=1
        continue
    fi
    OTHER_FILES_STAGED=1

    # Check whether this file has substantive (non-trivial) changes.
    # Get the cached diff for just this file.
    FILE_DIFF=$(git diff --cached -- "$f" 2>/dev/null || true)
    # Count lines that are real additions/removals:
    #   - Start with + or -
    #   - Are NOT diff headers (+++ or ---)
    #   - Are NOT whitespace-only (at least one non-space char after +/-)
    REAL_CHANGES=$(echo "$FILE_DIFF" | grep -E '^[+-]' | grep -vE '^[+-]{3}' | grep -vE '^[+-][[:space:]]*$' | wc -l || true)
    # Binary files: git diff shows "Binary files ... differ" — count as meaningful.
    if echo "$FILE_DIFF" | grep -q '^Binary files '; then
        MEANINGFUL_CHANGE=1
    elif [ "$REAL_CHANGES" -gt 0 ]; then
        MEANINGFUL_CHANGE=1
    fi
done

if [ "$DEPLOYED_HASH_STAGED" -eq 0 ]; then
    echo "⏭️  GATE 6 SKIPPED: .deployed-hash not staged."
elif [ "$OTHER_FILES_STAGED" -eq 0 ]; then
    echo "⛔ GATE 6 FAILED: .deployed-hash is the ONLY staged file."
    echo "   Commit 7ad9ad9 exhibited this pattern — claimed code fix but"
    echo "   only changed the deployment marker with 0 source changes."
    echo "   Either: add source changes alongside .deployed-hash, or"
    echo "   unstage .deployed-hash and commit the source changes separately."
    FAIL=$((FAIL + 1))
elif [ "$MEANINGFUL_CHANGE" -eq 0 ]; then
    echo "⛔ GATE 6 FAILED: .deployed-hash staged with no meaningful changes."
    echo "   Co-staged files have only trivial content (empty, whitespace-only)."
    echo "   This bypasses the solo-commit check without real source changes."
    echo "   Verify that staged source files contain actual code modifications."
    FAIL=$((FAIL + 1))
else
    echo "✅ GATE 6 PASSED: .deployed-hash accompanied by meaningful changes."
    PASS=$((PASS + 1))
fi

# ── GATE 7: Checkpoint Band Gate ──────────────────────────────
# Block Player from modifying Coach-owned checkpoint fields.
# The Coach writes verdict independently; Player must not alter
# any coach_review.* field or the top-level 'note' field.
# Protected fields: last_reviewed_sha, last_reviewed_at, verdict,
# findings_count, has_evidence, assertion_specs, watchdog_verified,
# watchdog_bypass, notes, commit_pending, and top-level note.
#
# ── player_note governance (intentionally NOT protected) ──────
# The top-level 'player_note' field is a Player-owned field and
# is intentionally NOT blocked by GATE 7. The Player writes their
# tick summary here each cycle. Content restrictions:
#   1. No API keys, credentials, or secrets (caught by GATE 2)
#   2. No Coach-impersonating content (e.g., "Coach verdict: APPROVE")
#   3. No prompt injection or instruction-like language
#   4. Must be a factual tick summary — what changed, what was learned
# The Coach may read player_note for context but should never write
# to it. Coach findings belong in coach_review.notes, not player_note.
if echo "$STAGED_FILES" | grep -q ".checkpoint.json"; then
    CHECKPOINT_DIFF=$(git diff --cached -- .checkpoint.json 2>/dev/null || true)
    # All 9 coach_review.* fields
    PROTECTED_REVIEW='(last_reviewed_sha|last_reviewed_at|verdict|findings_count|has_evidence|assertion_specs|watchdog_verified|watchdog_bypass|notes|commit_pending)'
    COACH_FIELD_CHANGES=$(echo "$CHECKPOINT_DIFF" | grep -E "^[+-].*\"$PROTECTED_REVIEW\":" || true)
    # Top-level 'note' field (distinct from coach_review.notes)
    TOP_NOTE_CHANGES=$(echo "$CHECKPOINT_DIFF" | grep -E '^[+-][[:space:]]*"note"[[:space:]]*:' || true)
    if [ -n "$COACH_FIELD_CHANGES" ] || [ -n "$TOP_NOTE_CHANGES" ]; then
        echo "⛔ GATE 7 FAILED: Checkpoint band gate — Coach-owned fields modified."
        echo "   The following coach_review fields are protected and must not"
        echo "   be modified by the Player:"
        echo "     - coach_review.last_reviewed_sha"
        echo "     - coach_review.last_reviewed_at"
        echo "     - coach_review.verdict"
        echo "     - coach_review.findings_count"
        echo "     - coach_review.has_evidence"
        echo "     - coach_review.assertion_specs"
        echo "     - coach_review.watchdog_verified"
        echo "     - coach_review.watchdog_bypass"
        echo "     - coach_review.notes"
        echo "     - coach_review.commit_pending"
        echo "   Also protected: top-level 'note' field"
        echo "   Player may only update: current_task, last_sha, completed[]"
        [ -n "$COACH_FIELD_CHANGES" ] && echo "   Detected coach_review changes:" && echo "$COACH_FIELD_CHANGES" | sed 's/^/     /'
        [ -n "$TOP_NOTE_CHANGES" ] && echo "   Detected top-level note changes:" && echo "$TOP_NOTE_CHANGES" | sed 's/^/     /'
        echo "   The Coach writes verdict independently — remove these changes"
        echo "   from your commit or unstage .checkpoint.json."
        FAIL=$((FAIL + 1))
    else
        echo "✅ GATE 7 PASSED: No protected checkpoint fields modified."
        PASS=$((PASS + 1))
    fi
else
    echo "⏭️  GATE 7 SKIPPED: .checkpoint.json not staged."
fi

# ── GATE 8: Checkpoint current_sha Freshness ──────────────────
# Verify current_sha in .checkpoint.json matches actual HEAD.
# Checkpoint-only commits (chore: advance/complete task) create new
# HEADs without updating current_sha, causing staleness across ticks.
# This gate ensures every commit that touches .checkpoint.json
# acknowledges the current HEAD.
# For meta-only commits (no source code staged), HEAD~1 is also
# accepted — the checkpoint tracks the last source commit, and
# meta-only commits advance HEAD past that source commit.
if echo "$STAGED_FILES" | grep -q ".checkpoint.json"; then
    # Extract current_sha from the STAGED version (what would be committed)
    STAGED_CURRENT_SHA=$(git show ":.checkpoint.json" 2>/dev/null | python3 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    print(data.get('current_sha', ''))
except: pass
" 2>/dev/null || echo "")
    ACTUAL_HEAD=$(git rev-parse HEAD)

    # Detect meta-only commit: no source code files staged
    # Source paths: apps/api/, apps/web/src/, packages/, apps/solver/
    IS_META_ONLY=true
    for f in $STAGED_FILES; do
        case "$f" in
            apps/api/*|apps/web/src/*|packages/*|apps/solver/*)
                IS_META_ONLY=false ;;
        esac
    done

    if [ -z "$STAGED_CURRENT_SHA" ]; then
        echo "⚠️  GATE 8 WARNING: current_sha field missing from .checkpoint.json."
        echo "   Add '\"current_sha\": \"$ACTUAL_HEAD\"' to .checkpoint.json."
        echo "   Proceeding (non-blocking) — but fix for next commit."
    elif echo "$ACTUAL_HEAD" | grep -q "^$STAGED_CURRENT_SHA"; then
        echo "✅ GATE 8 PASSED: current_sha matches HEAD ($ACTUAL_HEAD)."
        PASS=$((PASS + 1))
    elif [ "$IS_META_ONLY" = true ]; then
        PARENT_HEAD=$(git rev-parse HEAD~1 2>/dev/null || echo "")
        if [ -n "$PARENT_HEAD" ] && echo "$PARENT_HEAD" | grep -q "^$STAGED_CURRENT_SHA"; then
            echo "✅ GATE 8 PASSED (meta-only commit): current_sha matches parent HEAD ($PARENT_HEAD)."
            PASS=$((PASS + 1))
        else
            echo "⛔ GATE 8 FAILED: Checkpoint current_sha is stale."
            echo "   current_sha in staged .checkpoint.json: $STAGED_CURRENT_SHA"
            echo "   Actual HEAD:                           $ACTUAL_HEAD"
            echo "   Parent HEAD:                           $(git rev-parse HEAD~1 2>/dev/null || echo 'N/A')"
            echo "   Fix: update current_sha in .checkpoint.json to $ACTUAL_HEAD"
            echo "   then git add .checkpoint.json and retry."
            FAIL=$((FAIL + 1))
        fi
    else
        echo "⛔ GATE 8 FAILED: Checkpoint current_sha is stale."
        echo "   current_sha in staged .checkpoint.json: $STAGED_CURRENT_SHA"
        echo "   Actual HEAD:                           $ACTUAL_HEAD"
        echo "   The current_sha field must match HEAD before committing."
        echo "   Fix: update current_sha in .checkpoint.json to $ACTUAL_HEAD"
        echo "   then git add .checkpoint.json and retry."
        FAIL=$((FAIL + 1))
    fi
else
    echo "⏭️  GATE 8 SKIPPED: .checkpoint.json not staged."
fi

# ── Summary ────────────────────────────────────────────────────
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "  Structural Gates: $PASS passed, $FAIL failed"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"

if [ "$FAIL" -gt 0 ]; then
    echo ""
    echo "Commit blocked by structural enforcement gates."
    echo "These gates exist because TRAIL (Patronus 2025) proved LLM review"
    echo "has only 11% accuracy at detecting errors in agent traces."
    echo "Fix the failures above and try again."
    exit 1
fi

echo "All structural gates passed. Proceeding with commit."
exit 0
   
